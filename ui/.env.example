# SilverTrade AI — UI Environment Variables
# Copy this file to .env.local and adjust for your environment.
# In production, set these via Docker/CI.

# Platform API base URL (Flask backend on port 5000)
NEXT_PUBLIC_PLATFORM_URL=http://127.0.0.1:5000

# Strategy Engine base URL (Flask backend on port 5007)
NEXT_PUBLIC_STRATEGY_URL=http://127.0.0.1:5007

# Data Fetch service base URL (Flask backend on port 5005)
NEXT_PUBLIC_DATA_URL=http://127.0.0.1:5005

# WebSocket proxy URL (port 8765)
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8765
