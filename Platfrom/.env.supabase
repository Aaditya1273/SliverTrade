# ═══════════════════════════════════════════════════════════════════
# SilverTrade AI — Supabase PostgreSQL Configuration
# ═══════════════════════════════════════════════════════════════════
#
# Copy the relevant lines to your .env file.
# IMPORTANT: The password 'rawat_!@#123' contains special characters
# that MUST be URL-encoded in the connection string:
#   ! → %21
#   @ → %40
#   # → %23
#
# Encoded password: rawat_%21%40%23123
#
# ═══════════════════════════════════════════════════════════════════

# ── Supabase Connection ─────────────────────────────────────────
SUPABASE_HOST="aws-1-ap-northeast-1.pooler.supabase.com"
SUPABASE_PORT=6543
SUPABASE_USER="postgres.javcktpgxgsdcjpoqtkn"
SUPABASE_PASSWORD="rawat_!@#123"
SUPABASE_DB="postgres"

# ── Main Database (Auth, Users, Settings, Strategies, Symbols) ──
# Tables: auth, api_keys, active_sessions, login_attempts, user, settings,
#         strategy, chartink_strategy, symbol, telegram_users, bot_config,
#         flow_workflows, chart_prefs, market_calendar, qty_freeze,
#         leverage_config, strategy_portfolio, master_contract_status,
#         action_center_pending, analyzer_logs, api_order_logs
#
# Schema: public
DATABASE_URL='postgresql+psycopg2://postgres.javcktpgxgsdcjpoqtkn:rawat_%21%40%23123@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres'

# ── Logs Database (Traffic, IP Bans, 404 Tracker) ───────────────
# Tables: traffic_logs, ip_bans, error_404_tracker, invalid_api_key_tracker
#
# Schema: logs
# Note: Using ?options=-c%20search_path=logs to set the schema
# This keeps traffic logs logically isolated from main data
LOGS_DATABASE_URL='postgresql+psycopg2://postgres.javcktpgxgsdcjpoqtkn:rawat_%21%40%23123@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?options=-c%20search_path=logs'

# ── Latency Database (Order Execution Monitoring) ───────────────
# Tables: order_latency
#
# Schema: latency
LATENCY_DATABASE_URL='postgresql+psycopg2://postgres.javcktpgxgsdcjpoqtkn:rawat_%21%40%23123@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?options=-c%20search_path=latency'

# ── Health Database (System Metrics & Alerts) ───────────────────
# Tables: health_metrics, health_alerts
#
# Schema: health
HEALTH_DATABASE_URL='postgresql+psycopg2://postgres.javcktpgxgsdcjpoqtkn:rawat_%21%40%23123@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?options=-c%20search_path=health'

# ── Sandbox Database (Paper Trading / Analyzer Mode) ────────────
# Tables: sandbox_orders, sandbox_trades, sandbox_positions,
#         sandbox_holdings, sandbox_funds, sandbox_daily_pnl,
#         sandbox_config, sandbox_gtt, sandbox_gtt_legs
#
# Schema: sandbox
SANDBOX_DATABASE_URL='postgresql+psycopg2://postgres.javcktpgxgsdcjpoqtkn:rawat_%21%40%23123@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?options=-c%20search_path=sandbox'

# ── Old SQLite URLs (keep as backup until migration verified) ───
# DATABASE_URL='sqlite:///db/silvertrade.db'
# LOGS_DATABASE_URL='sqlite:///db/logs.db'
# LATENCY_DATABASE_URL='sqlite:///db/latency.db'
# HEALTH_DATABASE_URL='sqlite:///db/health.db'
# SANDBOX_DATABASE_URL='sqlite:///db/sandbox.db'

# ── PostgreSQL Pool Settings ────────────────────────────────────
# These are used by sqlalchemy engine creation in each database module
# For Supabase's PgBouncer (transaction mode), smaller pools work better
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=True
