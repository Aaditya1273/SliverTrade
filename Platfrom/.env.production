# =============================================================================
# SilverTrade AI — Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.production .env && nano .env
#
# Secrets marked with ⚠️ MUST be regenerated for production!
# =============================================================================
ENV_CONFIG_VERSION = '1.0.0'

# =============================================================================
# Domain & Broker Configuration
# =============================================================================
# ⚠️ Your production domain — used for OAuth callbacks, CORS, CSP, WebSocket URLs
HOST_SERVER = 'https://your-domain.com'

# ⚠️ Broker OAuth redirect URL (replace <broker> with your broker name, e.g. zerodha)
REDIRECT_URL = 'https://your-domain.com/<broker>/callback'

# ⚠️ Broker API credentials
BROKER_API_KEY = 'YOUR_BROKER_API_KEY'
BROKER_API_SECRET = 'YOUR_BROKER_API_SECRET'

# Market Data API (XTS brokers only, optional)
BROKER_API_KEY_MARKET = ''
BROKER_API_SECRET_MARKET = ''

# Comma-separated list of enabled brokers
VALID_BROKERS = 'fivepaisa,fivepaisaxts,aliceblue,angel,compositedge,definedge,deltaexchange,dhan,dhan_sandbox,firstock,flattrade,fyers,groww,ibulls,iifl,iiflcapital,indmoney,jainamxts,kotak,motilal,mstock,nubra,paytm,pocketful,rmoney,samco,shoonya,tradejini,upstox,wisdom,zebu,zerodha'

# =============================================================================
# Security ⚠️
# =============================================================================
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Rotating APP_KEY invalidates ALL active sessions.
# Rotating API_KEY_PEPPER corrupts ALL stored passwords and encrypted tokens.
# On first deploy, these are auto-generated. Keep them SECRET.
APP_KEY = 'regenerate-me-with-secrets-token-hex-32'
API_KEY_PEPPER = 'regenerate-me-with-secrets-token-hex-32'

# =============================================================================
# Database (PostgreSQL recommended for production)
# =============================================================================
# ⚠️ PostgreSQL (recommended — replace with your credentials):
DATABASE_URL = 'postgresql://silvertrade:silvertrade@postgres:5432/silvertrade'

# SQLite fallback (development only):
# DATABASE_URL = 'sqlite:///db/silvertrade.db'

LATENCY_DATABASE_URL = 'sqlite:///db/latency.db'
LOGS_DATABASE_URL = 'sqlite:///db/logs.db'
HEALTH_DATABASE_URL = 'sqlite:///db/health.db'
SANDBOX_DATABASE_URL = 'sqlite:///db/sandbox.db'
HISTORIFY_DATABASE_URL = 'db/historify.duckdb'

# =============================================================================
# Redis (caching, rate limiting, session store)
# =============================================================================
REDIS_URL = 'redis://redis:6379/0'

# =============================================================================
# Flask / Gunicorn
# =============================================================================
FLASK_HOST_IP = '0.0.0.0'
FLASK_PORT = '5000'
FLASK_DEBUG = 'False'
FLASK_ENV = 'production'

# =============================================================================
# WebSocket
# =============================================================================
WEBSOCKET_HOST = '0.0.0.0'
WEBSOCKET_PORT = '8765'
WEBSOCKET_URL = 'wss://your-domain.com/ws'

# ZeroMQ (internal message bus — always loopback)
ZMQ_HOST = '127.0.0.1'
ZMQ_PORT = '5555'

# =============================================================================
# WebSocket Connection Pooling
# =============================================================================
MAX_SYMBOLS_PER_WEBSOCKET = '1000'
MAX_WEBSOCKET_CONNECTIONS = '3'
ENABLE_CONNECTION_POOLING = 'true'

# =============================================================================
# Session & Expiry
# =============================================================================
SESSION_EXPIRY_TIME = '03:00'
SESSION_COOKIE_NAME = '__Secure-session'
CSRF_COOKIE_NAME = '__Secure-csrf_token'

# =============================================================================
# Rate Limiting
# =============================================================================
LOGIN_RATE_LIMIT_MIN = '5 per minute'
LOGIN_RATE_LIMIT_HOUR = '25 per hour'
RESET_RATE_LIMIT = '15 per hour'
API_RATE_LIMIT = '100 per second'
ORDER_RATE_LIMIT = '20 per second'
SMART_ORDER_RATE_LIMIT = '20 per second'
WEBHOOK_RATE_LIMIT = '200 per minute'
STRATEGY_RATE_LIMIT = '500 per minute'

# =============================================================================
# Health Monitor Memory Thresholds (MB)
# =============================================================================
HEALTH_MEMORY_WARNING_THRESHOLD = '3000'
HEALTH_MEMORY_CRITICAL_THRESHOLD = '5000'

# =============================================================================
# CORS
# =============================================================================
CORS_ENABLED = 'TRUE'
CORS_ALLOWED_ORIGINS = 'https://your-domain.com'
CORS_ALLOWED_METHODS = 'GET,POST,DELETE,PUT,PATCH'
CORS_ALLOWED_HEADERS = 'Content-Type,Authorization,X-Requested-With'
CORS_EXPOSED_HEADERS = ''
CORS_ALLOW_CREDENTIALS = 'TRUE'
CORS_MAX_AGE = '86400'

# =============================================================================
# Content Security Policy (CSP)
# =============================================================================
CSP_ENABLED = 'TRUE'
CSP_REPORT_ONLY = 'FALSE'
CSP_DEFAULT_SRC = "'self'"
CSP_SCRIPT_SRC = "'self' 'unsafe-inline' https://cdn.socket.io"
CSP_STYLE_SRC = "'self' 'unsafe-inline'"
CSP_IMG_SRC = "'self' data:"
CSP_CONNECT_SRC = "'self' wss://your-domain.com wss: ws: https://cdn.socket.io"
CSP_FONT_SRC = "'self'"
CSP_OBJECT_SRC = "'none'"
CSP_MEDIA_SRC = "'self' data:"
CSP_FRAME_SRC = "'self'"
CSP_FORM_ACTION = "'self'"
CSP_FRAME_ANCESTORS = "'self'"
CSP_BASE_URI = "'self'"
CSP_UPGRADE_INSECURE_REQUESTS = 'TRUE'
CSP_REPORT_URI = ''

# =============================================================================
# CSRF
# =============================================================================
CSRF_ENABLED = 'TRUE'
CSRF_TIME_LIMIT = ''

# =============================================================================
# Logging
# =============================================================================
LOG_TO_FILE = 'True'
LOG_LEVEL = 'INFO'
LOG_DIR = 'log'
LOG_RETENTION = '14'
LOG_COLORS = 'False'
FORCE_COLOR = '0'

# =============================================================================
# Strategy Limits
# =============================================================================
STRATEGY_MEMORY_LIMIT_MB = '1024'
STRATEGY_LOG_MAX_FILES = '10'
STRATEGY_LOG_MAX_SIZE_MB = '50'
STRATEGY_LOG_RETENTION_DAYS = '7'

# =============================================================================
# Thread Limits (Docker)
# =============================================================================
OPENBLAS_NUM_THREADS = '2'
OMP_NUM_THREADS = '2'
MKL_NUM_THREADS = '2'
NUMEXPR_NUM_THREADS = '2'
NUMBA_NUM_THREADS = '2'

# =============================================================================
# Ngrok (production: FALSE)
# =============================================================================
NGROK_ALLOW = 'FALSE'

# =============================================================================
# Service URLs (Docker Compose internal)
# =============================================================================
DATA_FETCH_URL = 'http://data_fetch:5005'
TRADE_STRATEGIES_URL = 'http://trade_strategies:5007'
